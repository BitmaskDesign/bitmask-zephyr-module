if BOARD_BMD100_NRF5340_CPUAPP || BOARD_BMD100_NRF5340_CPUAPP_NS

config BOARD_BMD100
	select USE_DT_CODE_PARTITION if BOARD_BMD100_NRF5340_CPUAPP_NS

config BT_HCI_IPC
	default y if BT_HCI

config HEAP_MEM_POOL_ADD_SIZE_BOARD
	int
	default 4096 if BT_HCI_IPC

# The console and shell are on USB CDC ACM (see cdc_acm_serial.dtsi).
# MCUboot doesn't bring up that USB stack, so it can't use it as a console.
config BOARD_SERIAL_BACKEND_CDC_ACM
	default n if MCUBOOT

source "boards/common/usb/Kconfig.cdc_acm_serial.defconfig"

# By default, a USB CDC ACM instance is already enabled in the board's DTS.
# It is not necessary for nRF Connect SDK to add another instance if MCUBoot
# bootloader is built as a child image.
config MCUBOOT_USB_SUPPORT
	bool
	default n

endif # BOARD_BMD100_NRF5340_CPUAPP || BOARD_BMD100_NRF5340_CPUAPP_NS
